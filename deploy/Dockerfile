# --- BASE IMAGE ---
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# --- BUILD STAGE ---
FROM base AS builder
WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_CULTURAGO_ENV
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE
ARG NEXT_PUBLIC_STELLAR_RPC_URL
ARG NEXT_PUBLIC_ENTITY_REGISTRY_CONTRACT_ID
ARG NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT_ID
ARG NEXT_PUBLIC_STELLAR_EXPLORER_BASE
ARG NEXT_PUBLIC_SMART_WALLET_WASM_HASH
ARG NEXT_PUBLIC_SMART_WALLET_ACCEPTED_WASM_HASHES

ENV NEXT_PUBLIC_CULTURAGO_ENV="$NEXT_PUBLIC_CULTURAGO_ENV"
ENV NEXT_PUBLIC_APP_URL="$NEXT_PUBLIC_APP_URL"
ENV NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="$NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE"
ENV NEXT_PUBLIC_STELLAR_RPC_URL="$NEXT_PUBLIC_STELLAR_RPC_URL"
ENV NEXT_PUBLIC_ENTITY_REGISTRY_CONTRACT_ID="$NEXT_PUBLIC_ENTITY_REGISTRY_CONTRACT_ID"
ENV NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT_ID="$NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT_ID"
ENV NEXT_PUBLIC_STELLAR_EXPLORER_BASE="$NEXT_PUBLIC_STELLAR_EXPLORER_BASE"
ENV NEXT_PUBLIC_SMART_WALLET_WASM_HASH="$NEXT_PUBLIC_SMART_WALLET_WASM_HASH"
ENV NEXT_PUBLIC_SMART_WALLET_ACCEPTED_WASM_HASHES="$NEXT_PUBLIC_SMART_WALLET_ACCEPTED_WASM_HASHES"
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV DOCKER_BUILD=1

RUN pnpm run build

# --- RUNNER STAGE ---
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3080
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3080

CMD ["node", "server.js"]
