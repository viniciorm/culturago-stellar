# CulturaGO — plantilla de configuración por entorno. NUNCA commitear valores reales.
# Valores válidos: demo | testnet | mainnet
NEXT_PUBLIC_CULTURAGO_ENV=demo
NEXT_PUBLIC_APP_URL=

# PostgreSQL directo (VPS). SOLO servidor: backend Next.js/workers por loopback
# o red privada Docker. NUNCA prefijar con NEXT_PUBLIC_, NUNCA en logs ni repo.
# En demo puede quedar vacío: la app corre con el motor mock local.
# Formato: postgres://culturago_app:<password>@127.0.0.1:5432/culturago
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_BACKUP_URL=
DATABASE_RESTORE_URL=
POSTGRES_BACKUP_DIR=./backups
POSTGRES_BACKUP_RETENTION_DAYS=7
POSTGRES_RPO_SECONDS=86400
POSTGRES_RTO_SECONDS=3600
POSTGRES_RESTORE_TARGET_GUARD=

# Stellar / Soroban (vacío en demo: prohibido generar enlaces o claims reales)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_ENTITY_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_EXPLORER_BASE=

# Smart wallet — pública para build del cliente
# Testnet canónico v1 (passkey-kit): fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0
# Ver docs/manifests/testnet-manifest.json y https://github.com/stellar/passkey-kit/docs/deployments-testnet-2026-07-11.md
NEXT_PUBLIC_SMART_WALLET_WASM_HASH=
NEXT_PUBLIC_SMART_WALLET_ACCEPTED_WASM_HASHES=
# Smart wallet — server-side: allowlist de WASM permitido (hex, separado por comas).
# NUNCA se expone al navegador; la ruta /api/smart-wallet/deploy valida el hash.
# Testnet canónico v1: fdefad64b96837147e1c333e51f537b696eab925e9f147e63d597c04e3c903f0
SMART_WALLET_WASM_HASH=
SMART_WALLET_ACCEPTED_WASM_HASHES=
STELLAR_SMART_WALLET_WASM_ALLOWLIST=
SMART_WALLET_RELAYER_BASE_URL=
SMART_WALLET_RELAYER_API_KEY=

# StellarWorker (proceso runtime) — deshabilitado en demo por defecto.
# Para testnet/mainnet se inicia vía src/instrumentation.ts.
STELLAR_WORKER_ENABLED=
STELLAR_WORKER_BATCH_SIZE=5
STELLAR_WORKER_POLL_INTERVAL_MS=5000
STELLAR_WORKER_CLAIM_TTL_SECONDS=60
STELLAR_WORKER_MAX_ATTEMPTS=10

# WebAuthn
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# Despliegue / proxy
CULTURAGO_DOMAIN=
ACME_EMAIL=
CULTURAGO_IMAGE=
CULTURAGO_IMAGE_TAG=
HOSTNAME=0.0.0.0
PORT=3080

# Smoke / despliegue Testnet (requiere aprobación aparte)
CULTURAGO_ALLOW_TESTNET_MUTATIONS=false
CULTURAGO_TESTNET_HARNESS_TOKEN=
CULTURAGO_TESTNET_ADMIN_TOKEN=
TESTNET_MANIFEST_PATH=docs/manifests/testnet-manifest.json
TESTNET_SMOKE_RUN_ID=
TESTNET_POLL_TIMEOUT_SECONDS=120

# Testnet admin: único que puede conceder roles. NUNCA fee payer ni deployer.
# Requiere kill switch explícito. NUNCA habilitar en mainnet.
CULTURAGO_ALLOW_TESTNET_ADMIN_SIGNER=false
STELLAR_TESTNET_ADMIN_SECRET=
STELLAR_TESTNET_ADMIN_ADDRESS=

# Fee payer para operaciones patrocinadas (restore/smart wallet). NUNCA admin.
STELLAR_FEEPAYER_SECRET=
STELLAR_FEEPAYER_ADDRESS=

# Testnet fixture signer: solo para pruebas E2E controladas.
CULTURAGO_ALLOW_TESTNET_FIXTURE_SIGNER=false
STELLAR_TESTNET_FIXTURE_SECRET=

# Deployer de contratos (usado en scripts de despliegue, no en runtime).
STELLAR_TESTNET_DEPLOYER_SECRET=
STELLAR_TESTNET_REGISTRAR_ADDRESS=
STELLAR_TESTNET_ISSUER_OPERATOR_ADDRESS=

# VPS Credentials
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=
VPS_PASSWORD=
VPS_PORT=