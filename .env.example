# CulturaGO — plantilla de configuración por entorno. NUNCA commitear valores reales.
# Valores válidos: demo | testnet | mainnet
NEXT_PUBLIC_CULTURAGO_ENV=demo

# PostgreSQL directo (VPS). SOLO servidor: backend Next.js/workers por loopback
# o red privada Docker. NUNCA prefijar con NEXT_PUBLIC_, NUNCA en logs ni repo.
# En demo puede quedar vacío: la app corre con el motor mock local.
# Formato: postgres://culturago_app:<password>@127.0.0.1:5432/culturago
DATABASE_URL=

# Stellar / Soroban (vacío en demo: prohibido generar enlaces o claims reales)
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_ENTITY_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_CREDENTIAL_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_EXPLORER_BASE=
